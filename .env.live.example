# QORE live broker handoff template.
# Copy the values you choose into .env.local. Never commit real keys.

# Start with dry-run, then paper, then live.
QORE_BROKER_MODE=dry-run

# Alpaca accepts APCA_* names; QORE_ALPACA_* aliases also work.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Paper account routing. Set QORE_BROKER_MODE=paper and enable this for Alpaca paper orders.
QORE_PAPER_ORDER_ROUTING_ENABLED=0

# Real-money routing. These three must all be present for QORE_BROKER_MODE=live.
QORE_LIVE_TRADING_ENABLED=0
QORE_LIVE_ORDER_ROUTING_ENABLED=0
QORE_CONFIRM_LIVE_TRADING=

# Exact all-year replication can require negative UNG exposure.
# Use only with a margin/short-capable account and after reviewing Alpaca borrow status.
# QORE forces whole-share sizing for short UNG targets because Alpaca does not support fractional short-sale orders.
QORE_ALPACA_ALLOW_SHORTS=0
QORE_ALPACA_ALLOW_HARD_TO_BORROW=0

# Sizing. 100 means QORE reconciles the strategy against the full broker equity.
QORE_LIVE_ACCOUNT_ALLOCATION_PCT=100
QORE_LIVE_MIN_CASH_BUFFER_PCT=2
QORE_LIVE_MIN_ORDER_USD=10
# Ignore ordinary mark-to-market drift below this percentage of current equity.
QORE_LIVE_REBALANCE_DEADBAND_PCT=0.25
QORE_LIVE_MAX_GROSS_EXPOSURE_PCT=100
QORE_LIVE_MAX_DAILY_LOSS_PCT=12
QORE_LIVE_MAX_TRAILING_DRAWDOWN_PCT=25
# Generated risk state must be recent and not materially future-dated before paper/live routing.
QORE_LIVE_MAX_RISK_SNAPSHOT_AGE_SECONDS=900
QORE_LIVE_MAX_RISK_SNAPSHOT_FUTURE_SKEW_SECONDS=30

# Alpaca IEX latest quotes are used for executable midpoint, spread, and quote-freshness checks.
QORE_ALPACA_MARKET_DATA_FEED=iex
QORE_LIVE_MAX_QUOTE_AGE_MINUTES=5
QORE_LIVE_MAX_QUOTE_FUTURE_SKEW_SECONDS=5
# Alpaca's market clock must be open and carry a recent, non-future timestamp at preflight and each mutation.
QORE_ALPACA_CLOCK_MAX_AGE_SECONDS=30
QORE_ALPACA_CLOCK_MAX_FUTURE_SKEW_SECONDS=5
# Abort an unresponsive Alpaca request so the broker operation cannot hang indefinitely.
QORE_ALPACA_REQUEST_TIMEOUT_MS=15000

# Dry-run diagnostic only. Paper/live always require fresh validated inference.
QORE_ALLOW_STALE_SIGNAL=0
# Operations.
# Every operator-state reader/writer uses QORE_LIVE_OPERATOR_STATE_FILE when set;
# otherwise it uses operator-state.json under QORE_LIVE_WEATHER_STATE_DIR.
# QORE_LIVE_WEATHER_STATE_DIR=.local/qore/live-weather
# QORE_LIVE_OPERATOR_STATE_FILE=.local/qore/live-weather/operator-state.json
# Set to 1 only when replacement should cancel and verify matching open Alpaca orders first.
QORE_ALPACA_REPLACE_OPEN_ORDERS=0
QORE_BROKER_RECONCILE_INTERVAL_MS=60000

# Private portfolio-report delivery. Preview commands do not need this gate.
# Enable one or more destinations in config/qore-portfolio-reports.json, then set this to 1.
QORE_REPORT_SEND_ENABLED=0
# QORE_REPORT_DISCORD_WEBHOOK_URL=
# QORE_REPORT_TELEGRAM_BOT_TOKEN=
# QORE_REPORT_TELEGRAM_CHAT_ID=
# QORE_REPORT_RESEND_API_KEY=
# QORE_REPORT_EMAIL_FROM=
# QORE_REPORT_EMAIL_TO=

# Historical Open-Meteo backfills are research-only and are skipped by the live supervisor by default.
# The live current-forecast handoff remains enabled. Opt in only for a deliberate backfill run.
QORE_LIVE_COLLECT_OPEN_METEO_ENABLED=0

# Selected-contract NOAA GFS/GEFS inference runs independently from research backfills.
QORE_LIVE_INFERENCE_LOOKBACK_DAYS=16
QORE_LIVE_INFERENCE_FETCH_TIMEOUT_MS=45000
# Default inference first refreshes completed daily bars into ignored local runtime state.
QORE_LIVE_MARKET_HISTORY_LOOKBACK_DAYS=270
QORE_LIVE_MARKET_HISTORY_FETCH_TIMEOUT_MS=45000
# Diagnostic only: reuse a same-target-date local manifest instead of refreshing it.
QORE_LIVE_INFERENCE_SKIP_MARKET_REFRESH=0
# Refuse to bridge an older cached close after this many calendar days. Intervening
# weekdays fail closed independently, including an unverified exchange holiday.
QORE_LIVE_INFERENCE_MAX_MARKET_AGE_DAYS=4
