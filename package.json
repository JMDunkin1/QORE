{
  "name": "qore",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "qore": "./bin/qore"
  },
  "scripts": {
    "postinstall": "node scripts/install-command.mjs --quiet",
    "dev": "node scripts/qore-local.mjs",
    "dev:vite": "vite",
    "github-service": "node scripts/qore-git-service.mjs",
    "collect:free-data": "node scripts/collect-free-data.mjs",
    "collect:prediction-time-ladder": "node scripts/collect-prediction-time-ladder.mjs",
    "collect:prediction-cross-market-rv": "node scripts/collect-prediction-cross-market-rv.mjs",
    "collect:prediction-time-decay": "node scripts/collect-prediction-time-decay.mjs",
    "collect:gfs-calendar": "node scripts/build-gfs-forecast-calendar.mjs",
    "collect:gefs-calendar": "QORE_FORECAST_SOURCE=gefs-mean node scripts/build-gfs-forecast-calendar.mjs",
    "collect:graphcast-calendar": "QORE_FORECAST_SOURCE=graphcastgfs QORE_GFS_CALENDAR_START=2024-04-26 node scripts/build-gfs-forecast-calendar.mjs",
    "optimize:arctic-strategies": "node scripts/optimize-arctic-strategies.mjs",
    "optimize:ngas-winter-alpha": "node scripts/optimize-ngas-winter-alpha.mjs",
    "optimize:ngas-summer-alpha": "node scripts/optimize-ngas-summer-alpha.mjs",
    "optimize:ngas-all-year-beta": "node scripts/optimize-ngas-all-year-beta.mjs",
    "optimize:ngas-live-weather-head-to-head": "node scripts/optimize-ngas-live-weather-head-to-head.mjs",
    "test:ngas-live-weather-refresh": "node scripts/test-ngas-live-weather-refresh.mjs",
    "live:weather": "node scripts/qore-live-weather-service.mjs",
    "live:weather:once": "node scripts/qore-live-weather-service.mjs --once",
    "live:infer": "node scripts/qore-live-strategy-inference.mjs",
    "live:weather:rapid": "node scripts/qore-live-weather-service.mjs --profile=rapid-test",
    "live:weather:fast": "node scripts/qore-live-weather-service.mjs --profile=fast",
    "live:weather:conservative": "node scripts/qore-live-weather-service.mjs --profile=conservative",
    "broker:alpaca:status": "node scripts/qore-alpaca-broker.mjs --status",
    "broker:alpaca:dry-run": "node scripts/qore-alpaca-broker.mjs --mode=dry-run --reconcile",
    "broker:alpaca:paper": "node scripts/qore-alpaca-broker.mjs --mode=paper --reconcile",
    "broker:alpaca:live": "node scripts/qore-alpaca-broker.mjs --mode=live --reconcile",
    "broker:alpaca:reconcile": "node scripts/qore-alpaca-broker.mjs --reconcile",
    "live:trade": "node scripts/qore-live-trading-supervisor.mjs",
    "live:trade:once": "node scripts/qore-live-trading-supervisor.mjs --once",
    "live:prepare": "node scripts/qore-live-trading-supervisor.mjs --once --prepare",
    "live:readiness": "node scripts/qore-live-readiness.mjs",
    "live:kill-switch:status": "node scripts/qore-live-kill-switch.mjs status",
    "live:kill-switch:engage": "node scripts/qore-live-kill-switch.mjs engage",
    "live:kill-switch:clear": "node scripts/qore-live-kill-switch.mjs clear",
    "install:linux-service": "node scripts/install-linux-live-service.mjs",
    "install:command": "node scripts/install-command.mjs",
    "install:launch-agent": "node scripts/install-macos-launch-agent.mjs",
    "test:github-service": "node scripts/test-qore-git-service.mjs",
    "test:live-trading": "node scripts/test-qore-live-trading.mjs",
    "test:live-inference": "node scripts/test-qore-live-inference.mjs",
    "test:live-inference-fetch": "node scripts/test-qore-live-inference.mjs --live-fetch",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mattnucc/gribberish": "^0.30.2",
    "grib-js": "^1.0.0",
    "lucide-react": "^1.17.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
