{
  "recommendedBroker": {
    "id": "alpaca-trading-api",
    "accountType": "Alpaca Trading API individual taxable brokerage account",
    "exactStrategyRequirement": "Margin/short capability is needed when the all-year strategy targets negative UNG exposure.",
    "why": "QORE's current live-orderable contract is ETF-first: UNG for the gas overlay and VOO/QQQM for the index basket. The adapter deliberately refuses NG, MNG, and QG futures."
  },
  "alpaca": {
    "paperBaseUrl": "https://paper-api.alpaca.markets",
    "liveBaseUrl": "https://api.alpaca.markets",
    "dataBaseUrl": "https://data.alpaca.markets",
    "marketDataFeed": "iex",
    "symbols": ["UNG", "VOO", "QQQM"],
    "excludedSymbols": ["NG", "MNG", "QG"],
    "orderDefaults": {
      "type": "market",
      "timeInForce": "day",
      "fractionalOrders": true,
      "fractionalShortSales": false,
      "replaceOpenOrders": false,
      "minOrderUsd": 10
    },
    "reviewedExecutionProfile": {
      "schemaVersion": 1,
      "profileId": "alpaca-etf-target-weight-route-v1",
      "implementationPolicyId": "alpaca-live-etf-reconciler-v2",
      "futuresRouting": "blocked",
      "sizing": {
        "accountAllocationPct": 100,
        "minCashBufferPct": 2,
        "rebalanceDeadbandPct": 0.25,
        "rebalanceDeadbandPolicyId": "risk-reductions-and-ung-transitions-bypass-v1",
        "minOrderUsd": 10,
        "maxOrderUsd": null
      },
      "orders": {
        "type": "market",
        "timeInForce": "day",
        "fractionalNonShortOrders": true,
        "fractionalShortSales": false,
        "replaceOpenOrders": false,
        "shortExposureEnabled": true,
        "hardToBorrowAllowed": false
      }
    }
  },
  "gates": {
    "riskDefaults": {
      "maxGrossExposurePct": 100,
      "minConfidence": 0,
      "maxConfidence": 1,
      "maxSignalAgeDays": 1,
      "maxWeatherIssueAgeHours": 36,
      "maxMarketDataAgeMinutes": 1440,
      "maxStorageDataAgeDays": 10,
      "maxDailyLossPct": 12,
      "maxTrailingDrawdownPct": 25,
      "maxAllowedSpreadBps": 75,
      "maxQuoteAgeMinutes": 5,
      "maxQuoteFutureSkewSeconds": 5,
      "maxClockAgeSeconds": 30,
      "maxClockFutureSkewSeconds": 5,
      "alpacaRequestTimeoutMs": 15000,
      "maxRiskSnapshotAgeSeconds": 900,
      "maxRiskSnapshotFutureSkewSeconds": 30,
      "minReferencePriceUsd": 1,
      "minWeatherSourceCount": 2,
      "minWeatherCoveragePct": 70,
      "minWeatherDirectionalAccuracyPct": 52,
      "requireFreshWeatherContext": true,
      "requireStorageContext": true,
      "requireMarketContext": true,
      "requireAccountContext": true,
      "requireOperatorContext": true
    },
    "liveRequiredEnv": {
      "QORE_BROKER_MODE": "live",
      "QORE_LIVE_TRADING_ENABLED": "1",
      "QORE_LIVE_ORDER_ROUTING_ENABLED": "1",
      "QORE_CONFIRM_LIVE_TRADING": "I_UNDERSTAND_THIS_CAN_LOSE_MONEY"
    },
    "paperRequiredEnv": {
      "QORE_BROKER_MODE": "paper",
      "QORE_PAPER_ORDER_ROUTING_ENABLED": "1"
    }
  },
  "stateFiles": {
    "signalIntent": ".local/qore/live-weather/signal-intent-reconcile.json",
    "marketReference": ".local/qore/live-weather/market-reference-prices.json",
    "riskState": ".local/qore/live-weather/risk-and-kill-switch-state.json",
    "brokerSnapshot": ".local/qore/broker/account-snapshot.json",
    "brokerAccountStatus": ".local/qore/broker/account-status.json",
    "brokerStatus": ".local/qore/broker/status.json",
    "brokerLock": ".local/qore/broker/operation.lock",
    "brokerRiskLedger": ".local/qore/broker/risk-ledger.json",
    "orderLog": ".local/qore/broker/orders.jsonl",
    "supervisorStatus": ".local/qore/live-trading-supervisor/status.json",
    "supervisorLock": ".local/qore/live-trading-supervisor/supervisor.lock"
  }
}
